<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".GalleryActivity">

    <Button
        android:id="@+id/btnBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/txtGalleryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Animal Gallery"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <GridLayout
        android:id="@+id/galleryGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:columnCount="3"
        android:rowCount="3"
        android:alignmentMode="alignMargins"
        android:useDefaultMargins="true"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toBottomOf="@id/txtGalleryTitle"
        app:layout_constraintBottom_toTopOf="@id/galleryNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgAnimal1"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:scaleType="centerCrop"
            android:background="#DDDDDD"
            android:contentDescription="Animal picture 1"
            tools:src="@tools:sample/animals" />

        <ImageView
            android:id="@+id/imgAnimal2"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:scaleType="centerCrop"
            android:background="#DDDDDD"
            android:contentDescription="Animal picture 2"
            tools:src="@tools:sample/animals" />

        <ImageView
            android:id="@+id/imgAnimal3"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:scaleType="centerCrop"
            android:background="#DDDDDD"
            android:contentDescription="Animal picture 3"
            tools:src="@tools:sample/animals" />

        <ImageView
            android:id="@+id/imgAnimal4"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:scaleType="centerCrop"
            android:background="#DDDDDD"
            android:contentDescription="Animal picture 4"
            tools:src="@tools:sample/animals" />

        <ImageView
            android:id="@+id/imgAnimal5"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:scaleType="centerCrop"
            android:background="#DDDDDD"
            android:contentDescription="Animal picture 5"
            tools:src="@tools:sample/animals" />

        <ImageView
            android:id="@+id/imgAnimal6"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:scaleType="centerCrop"
            android:background="#DDDDDD"
            android:contentDescription="Animal picture 6"
            tools:src="@tools:sample/animals" />

        <ImageView
            android:id="@+id/imgAnimal7"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:scaleType="centerCrop"
            android:background="#DDDDDD"
            android:contentDescription="Animal picture 7"
            tools:src="@tools:sample/animals" />

        <ImageView
            android:id="@+id/imgAnimal8"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:scaleType="centerCrop"
            android:background="#DDDDDD"
            android:contentDescription="Animal picture 8"
            tools:src="@tools:sample/animals" />

        <ImageView
            android:id="@+id/imgAnimal9"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:scaleType="centerCrop"
            android:background="#DDDDDD"
            android:contentDescription="Animal picture 9"
            tools:src="@tools:sample/animals" />

    </GridLayout>

    <LinearLayout
        android:id="@+id/galleryNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnPrevious"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Previous"
            android:enabled="false" />

        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="Next" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
